{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: native save dialog and writing the file the user picked.",
  "windows": ["main"],
  "permissions": ["core:default", "dialog:allow-save", "fs:allow-write-text-file", { "identifier": "fs:scope", "allow": [{ "path": "$HOME/**" }, { "path": "$DOCUMENT/**" }, { "path": "$DESKTOP/**" }, { "path": "$DOWNLOAD/**" }] }]
}
