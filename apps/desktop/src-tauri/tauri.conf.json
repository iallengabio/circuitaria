{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Circuitaria",
  "version": "1.0.0",
  "identifier": "app.circuitaria.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm --filter ui dev"
  },
  "app": {
    "windows": [{ "title": "Circuitaria", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [{ "ext": ["circuito"], "name": "Circuitaria project", "role": "Editor" }]
  }
}
